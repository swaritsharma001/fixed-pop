entrypoint = "index.js"
modules = ["web", "nodejs-22"]
hidden = [".config", "package-lock.json"]

[gitHubImport]
requiredFiles = [".replit", "replit.nix", "package.json", "package-lock.json"]

[nix]
channel = "stable-25_05"
packages = ["jellyfin-ffmpeg", "vite", "np", "codespelunker"]

[deployment]
run = ["node", "index.js"]
deploymentTarget = "autoscale"
ignorePorts = false

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 4000
externalPort = 3002

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5173
externalPort = 5173
exposeLocalhost = true

[agent]
expertMode = true

[userenv]

[userenv.shared]
GMAIL_REDIRECT_URI = "https://d4c86a66-f9ee-49ea-972b-c097102dabfd-00-2ilnlopo2bzm9.sisko.replit.dev/api/v1/merchant/gmail/callback"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev:poppay"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
