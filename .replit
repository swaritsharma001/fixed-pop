entrypoint = "index.js"
modules = ["web", "nodejs-22"]
hidden = [".config", "package-lock.json"]

[gitHubImport]
requiredFiles = [".replit", "replit.nix", "package.json", "package-lock.json"]

[nix]
channel = "stable-25_05"
packages = ["jellyfin-ffmpeg", "vite", "np", "codespelunker"]

[deployment]
build = ["npm", "run", "build:client"]
run = ["sh", "-c", "PORT=5000 node server/src/index.js"]
deploymentTarget = "autoscale"
ignorePorts = false

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 4000
externalPort = 3002

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5173
externalPort = 5173
exposeLocalhost = true

[agent]
expertMode = true

[userenv]

[userenv.shared]
GMAIL_REDIRECT_URI = "https://8e940b42-8477-4eb4-be4d-bdcf0ab42dba-00-31uq9ahd8svan.pike.replit.dev/api/v1/merchant/gmail/callback"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev:poppay"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
