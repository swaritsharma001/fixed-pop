# PopPay Nginx Reverse Proxy Configuration for EC2
# Place this file in /etc/nginx/sites-available/poppay and symlink to /etc/nginx/sites-enabled/

server {
    listen 80;
    server_name your-domain.com www.your-domain.com; # Replace with your EC2 public IP or domain

    # Redirect all HTTP traffic to HTTPS (uncomment after running Certbot)
    # return 301 https://$host$request_uri;

    client_max_body_size 20M;

    # Frontend & API Reverse Proxy
    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;

        # Standard headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Server-Sent Events (SSE) & WebSocket Support
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
        proxy_read_timeout 24h;
    }
}
