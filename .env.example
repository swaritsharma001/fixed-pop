# ==============================================================================
# PopPay Production Environment Configuration
# Architecture:
#   Backend API: https://api.poppay.tech  (Deployed on EC2)
#   Frontend:    https://poppay.tech      (Deployed on Vercel)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. EC2 BACKEND ENVIRONMENT (Save to server/.env or /etc/environment)
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=production

# MongoDB Connection String (e.g. MongoDB Atlas replica set)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/poppay?retryWrites=true&w=majority

# JWT signing secret (Used to sign and verify Bearer tokens for merchants and admins)
JWT_SECRET=change_this_to_a_secure_random_string_at_least_32_characters

# AES-256-GCM Encryption key (64 hex characters / 32 bytes)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change_this_to_64_hex_characters_encryption_key_here

# Universal Admin Initial Password (for admin@maheshsharma.com)
ADMIN_PASSWORD=admin@maheshsharma.com

# Frontend and CORS Configuration
FRONTEND_URL=https://poppay.tech
ALLOWED_ORIGINS=https://poppay.tech,https://www.poppay.tech

# Google OAuth Credentials for Gmail Payment Alert Worker
# In Google Cloud Console: Set Authorized redirect URI to: https://api.poppay.tech/api/v1/merchant/gmail/callback
GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REDIRECT_URI=https://api.poppay.tech/api/v1/merchant/gmail/callback
GMAIL_POLL_INTERVAL_MS=30000

# ------------------------------------------------------------------------------
# 2. VERCEL FRONTEND ENVIRONMENT (Set in Vercel Project Settings -> Environment Variables)
# ------------------------------------------------------------------------------
# VITE_API_URL=https://api.poppay.tech
# Note: When hosted on poppay.tech, the frontend automatically defaults to
# https://api.poppay.tech even if this variable is omitted!
